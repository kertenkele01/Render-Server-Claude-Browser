# Environment for the MCP bridge server (server.js).
# Copy to .env and fill in. Nothing here is compiled into the Android app.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# DATABASE_URL: PostgreSQL connection string for accounts, devices, clients,
# claim codes, the audit trail and usage counters.
#
# Without it the relay falls back to a JSON file and says so, loudly, at
# startup and in the panel. That fallback exists so the relay still boots and
# can be developed against — it is NOT suitable for a real deployment: Render's
# container filesystem is ephemeral, so every deploy would take the accounts
# with it.
DATABASE_URL=

# BRIDGE_STATE_FILE: where the fallback file store lives when DATABASE_URL is
# empty. It holds hashes, never plaintext secrets, but still belongs outside
# version control (it is already in .gitignore).
BRIDGE_STATE_FILE=./.bridge-state.json

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------

# ALLOW_REGISTRATION: set to "false" to close signups on a private deployment.
# Open by default so a fresh install is usable; the first account is yours.
ALLOW_REGISTRATION=true

# Rate limits. The defaults are the numbers in lib/limits.js; override one only
# if you have a reason — a shared office behind a single NAT address is the
# usual one for LIMIT_REGISTER_MAX.
# LIMIT_LOGIN_MAX=10          # failed logins per 10 min, per address and per IP
# LIMIT_CREDENTIAL_MAX=20     # failed client keys per 5 min, per IP
# LIMIT_REGISTER_MAX=20       # signups per hour, per IP
# LIMIT_CLAIM_MAX=15          # claim-code attempts per 10 min

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# ALLOWED_ORIGINS: comma-separated origins allowed to call the bridge from a
# browser and to open a WebSocket. MCP clients are not browsers, so leave this
# empty unless you deliberately put a web app in front of the bridge.
ALLOWED_ORIGINS=

# PORT: HTTP port for the bridge (Render sets this automatically).
PORT=10000
