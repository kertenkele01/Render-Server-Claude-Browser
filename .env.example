# Copy to .env for local development. On Render these are set in the
# dashboard (or generated by render.yaml) — do not commit a filled-in .env.

# ---------------------------------------------------------------------------
# Bridge relay
# ---------------------------------------------------------------------------

# ADMIN_TOKEN: unlocks the operator console at "/" and GET /api/status.
# Leave empty and the console stays closed rather than defaulting to public.
# Must be at least 24 characters: there is no attempt limit behind this token,
# so anything shorter is ignored (with a startup warning) rather than
# half-trusted.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ADMIN_PUBLIC: set to "true" to open the operator console with no login at all.
# The console is read-only and shows no secret, but it does list paired clients
# and a live feed of the hosts the phone is visiting — that is browsing history,
# and a Render URL is guessable. Opt in only on a deployment you are comfortable
# being public. Leave empty to keep the ADMIN_TOKEN login.
ADMIN_PUBLIC=

# ALLOWED_ORIGINS: comma-separated origins allowed to call the bridge from a
# browser and to open a WebSocket. MCP clients are not browsers, so leave this
# empty unless you deliberately put a web app in front of the bridge.
ALLOWED_ORIGINS=

# PORT: Render sets this automatically. Only needed locally.
PORT=10000

# BRIDGE_STATE_FILE: where the device/client registry is persisted. It holds
# only hashes, never plaintext secrets, but still belongs outside version
# control. On Render this needs a mounted disk to survive deploys.
BRIDGE_STATE_FILE=./.bridge-state.json

# ---------------------------------------------------------------------------
# Crawl4AI integration
# Powers browser_get_markdown. The bridge posts the DOM the device already
# rendered, so pages behind a login convert correctly. Leave CRAWL4AI_API_URL
# empty to disable it — browser_get_local_markdown keeps working either way.
#
# Note: the rendered HTML of a logged-in page can contain personal content
# (names, addresses, message bodies). It never contains typed passwords, but
# this transfer must still be declared in the Play Data Safety form.
# ---------------------------------------------------------------------------
CRAWL4AI_API_URL=
CRAWL4AI_API_TOKEN=
